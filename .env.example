# Copier en .env et renseigner les valeurs du projet Supabase (Settings → API).
# Sans ces variables, l'app vise la stack locale (npm run db:start).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
# Identifiant du projet EAS (nécessaire pour les notifications push)
EXPO_PUBLIC_EAS_PROJECT_ID=
# Numéro WhatsApp de l'aide Natt et numéro Wave pour payer les abonnements (sans « + »)
EXPO_PUBLIC_NUMERO_AIDE=
EXPO_PUBLIC_NUMERO_WAVE_NATT=
