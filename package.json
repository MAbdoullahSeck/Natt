    "db:seed": "python3 scripts/supabase_api.py seed",
    "db:test": "supabase test db --linked",
    "db:types": "supabase gen types typescript --linked > src/lib/database.types.ts",
    "db:api:migrations": "python3 scripts/supabase_api.py migrations",
    "db:api:tests": "python3 scripts/supabase_api.py tests",
    "db:local:start": "supabase start",
    "db:local:reset": "supabase db reset",
    "db:local:test": "supabase test db",
    "db:local:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "fn:deploy": "supabase functions deploy --use-api"
  },
